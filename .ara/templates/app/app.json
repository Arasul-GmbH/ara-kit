{
  "schema": 1,
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "0.1.0",
  "beschreibung": "{{beschreibung}}",
  "marken": "{{marken}}",
  "frontend": {
    "verzeichnis": "frontend"
  },
  "backend": {
    "image": "arasul-{{id}}:0.1.0",
    "bauen": {
      "verzeichnis": "backend"
    },
    "gesundheit": "/gesund",
    "umgebung": {
      "ARASUL_APP_NAME": "{{name}}"
    }
  },
  "ports": {
    "backend": 8080
  },
  "ressourcen": {
    "speicher": "128m",
    "cpus": 0.25
  },
  "modelle": [],
  "flows": {
    "verzeichnis": "flows"
  },
  "agent": [
    {
      "method": "GET",
      "path": "vorgaenge",
      "purpose": "Alle Vorgänge der App, mit dem Stand ihrer Freigabe.",
      "params": [],
      "writes": false
    },
    {
      "method": "POST",
      "path": "vorgaenge",
      "purpose": "Einen Vorgang einreichen und damit den Flow freigabe starten.",
      "params": [
        { "name": "titel", "type": "string", "required": true },
        { "name": "text", "type": "string", "required": false }
      ],
      "writes": true
    }
  ]
}
