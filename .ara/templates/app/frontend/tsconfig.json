{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `node` steht dabei, weil `vite.config.ts` mitgeprueft wird und dort
    // `node:url` steht. Ohne diese Typen faellt `tsc --noEmit` an der ersten
    // Zeile der Bau-Einstellungen, und zwar erst beim Bauen.
    "types": ["vite/client", "node"],

    // Derselbe Alias wie in `vite.config.ts` und in der Oberflaeche des
    // Geraets. Ohne ihn faende `tsc --noEmit` die Bibliothek nicht, und der
    // Bau bliebe erst im Browser stehen.
    "baseUrl": ".",
    "paths": { "@marken": ["./src/marken/index.ts"] },
    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,

    // Streng, und zwar von Anfang an. Eine Vorlage, die locker anfaengt, wird
    // nie streng: der Tag, an dem jemand die Schalter umlegt, ist der Tag mit
    // zweihundert Fehlern.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "vite.config.ts"]
}
