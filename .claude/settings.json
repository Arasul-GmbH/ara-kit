{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(node .ara/tools/:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git pull:*)",
      "Bash(uname:*)",
      "Bash(sw_vers:*)",
      "Bash(which:*)",
      "Bash(df:*)",
      "Bash(ping:*)",
      "Bash(ssh-keygen -l:*)",
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue list:*)",
      "mcp__playwright",
      "Read(./customers/**)",
      "Read(./business/**)",
      "Read(./devices/**)",
      "Read(./.ara/**)",
      "Write(./customers/**)",
      "Write(./business/**)",
      "Write(./devices/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(cat ./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ara/tools/guard.mjs\""
          }
        ]
      }
    ]
  }
}
