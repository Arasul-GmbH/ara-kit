{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .ara/werkzeuge/:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git pull:*)",
      "Bash(uname:*)",
      "Bash(sw_vers:*)",
      "Bash(which:*)",
      "Bash(df:*)",
      "Bash(ping:*)",
      "Bash(ssh-keygen -l:*)",
      "Read(./kunden/**)",
      "Read(./mein/**)",
      "Read(./.ara/**)",
      "Write(./kunden/**)",
      "Write(./mein/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(cat ./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ara/werkzeuge/riegel.mjs\""
          }
        ]
      }
    ]
  }
}
