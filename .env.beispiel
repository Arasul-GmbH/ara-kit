# Vorlage. /start legt daraus deine echte .env an.
# Die .env ist von der Versionskontrolle ausgenommen und wird vom Agenten nicht gelesen.

# Lizenztoken aus dem Arasul-Partnerportal.
# Damit lädt das Kit den aktuellen Produktstand (Spiegel) und installiert auf Geräten.
ARASUL_TOKEN=

# Basis-Adresse des Portals. Nur ändern, wenn du weißt warum.
ARASUL_BASIS=https://arasul.de
