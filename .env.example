# Template. /init makes your real .env out of it.
# The .env is excluded from version control and is not read by the agent.
# Enter a value without touching the file:
#   node .ara/tools/secrets.mjs --set ARASUL_TOKEN

# Licence token from the Arasul partner portal.
# With it the kit fetches the current product version (the mirror) and installs on devices.
ARASUL_TOKEN=

# Base address of the portal. Only change it if you know why.
ARASUL_BASIS=https://arasul.de
